{
  "name": "hitapi",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "worker",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=worker\" \"npm run dev --workspace=frontend\"",
    "build": "npm run build --workspace=frontend",
    "deploy": "npm run deploy --workspace=worker && npm run deploy --workspace=frontend",
    "install:all": "npm install && npm install --workspace=worker && npm install --workspace=frontend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "wrangler": "^4.129.1"
  },
  "overrides": {
    "vite": "6.3.5"
  },
  "dependencies": {
    "curlconverter": "^4.12.0",
    "js-yaml": "^5.4.1"
  }
}
