# Keep the Cloudflare Pages preview domain (hitapi.pages.dev and preview
# deployments) out of Google, so only https://hitapi.dev is indexed.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

# Demo video and poster: cache for a week in browsers and at Cloudflare's edge
/media/*
  Cache-Control: public, max-age=604800
